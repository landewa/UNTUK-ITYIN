# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=""

# OWNER_PASSCODE: Required server-side secret passcode to unlock Owner Studio editing.
# Must be set in deployment secrets; Owner Studio login fails closed if unset.
OWNER_PASSCODE=""

# OWNER_SESSION_SECRET: High-entropy secret used to sign Owner Studio session tokens.
# Recommended in production so tokens remain valid across container restarts.
OWNER_SESSION_SECRET=""

# SUPABASE PERSISTENT STORAGE (Recommended for Cloud Run / ephemeral container hosts)
# Keep SUPABASE_SERVICE_ROLE_KEY strictly on the server; never expose it in VITE_* vars.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="universe-photos"
